{
  "manifest_version": 3,
  "name": "DivSnap",
  "version": "1.2.0",
  "description": "Inspect a DOM element and capture its visible or full layout box.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "DivSnap",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "start-inspect": {
      "description": "Start DOM Inspector"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["overlay.css"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ]
}
